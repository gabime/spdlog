{
    "version": "0.2.0",
    "configurations": [     
        {
            "name": "Debug Automation (CMake Tools)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/example",
            "environment": [
                {
                    "name": "PATH",
                    "value": "E:\\Qt\\6.8.3\\mingw_64\\bin;E:\\Qt\\Tools\\mingw1120_64\\bin;${workspaceFolder}\\build\\example;${env:PATH}"
                },
                {
                    "name": "QT_PLUGIN_PATH",
